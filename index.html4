<!doctype html>
<html lang="zh-Hant-TW">
<head>
<meta charset="utf-8">
<meta name="viewport" content="width=device-width,initial-scale=1,viewport-fit=cover">
<meta name="theme-color" content="#0b0f0c">
<title>ATS</title>
<style>
:root{--bg:#0b0f0c;--panel:#151c17;--panel2:#1c261f;--text:#f4f7f4;--muted:#a9b3ab;--accent:#83a978;--danger:#d85c5c;--line:#2c392f}
*{box-sizing:border-box}
body{margin:0;background:var(--bg);color:var(--text);font-family:-apple-system,BlinkMacSystemFont,"PingFang TC","Microsoft JhengHei",sans-serif}
main{max-width:560px;margin:auto;padding:18px;min-height:100vh}
header{display:flex;align-items:center;justify-content:space-between;margin-bottom:18px}
.brand{display:flex;gap:12px;align-items:center}.logo{width:50px;height:50px;border:2px solid var(--accent);border-radius:13px;display:grid;place-items:center;font-weight:900}
h1{font-size:24px;margin:0}.sub{font-size:12px;color:var(--muted);margin-top:3px}
.card{background:var(--panel);border:1px solid var(--line);border-radius:18px;padding:18px;margin-bottom:14px}
.hero h2{font-size:32px;margin:8px 0}.hero p{color:var(--muted);line-height:1.6}.eyebrow{color:var(--accent);font-weight:800;font-size:13px}
.stack{display:grid;gap:12px}.grid2{display:grid;grid-template-columns:1fr 1fr;gap:12px}
button,input,select{font:inherit}
.btn{min-height:64px;border-radius:16px;border:1px solid var(--line);font-size:20px;font-weight:800;padding:12px 16px}
.primary{background:var(--accent);color:#091009;border-color:transparent}.secondary{background:var(--panel2);color:var(--text)}.danger{background:var(--danger);color:white;border-color:transparent}
.field{display:grid;gap:7px;margin-bottom:13px}.field label{color:var(--muted);font-size:14px}.field input,.field select{width:100%;padding:15px;border-radius:13px;border:1px solid var(--line);background:#0d120e;color:var(--text);font-size:18px}
.screen{display:none}.screen.active{display:block}
.roomcode{text-align:center;font-size:48px;font-weight:900;letter-spacing:.12em;color:var(--accent);margin:10px 0}
.status{display:flex;justify-content:space-between;align-items:center;gap:10px}.badge{padding:8px 12px;border-radius:999px;background:var(--panel2);border:1px solid var(--line);font-size:14px;font-weight:800}
.list{display:grid;gap:10px}.player{display:flex;justify-content:space-between;align-items:center;padding:13px;border-radius:13px;background:#0e140f;border:1px solid var(--line)}
.player small{display:block;color:var(--muted);margin-top:4px}
.timer{text-align:center;font-size:60px;font-weight:900;margin:12px 0}
.actions{display:grid;grid-template-columns:1fr 1fr;gap:12px}.action{min-height:115px;border-radius:18px;border:1px solid var(--line);background:var(--panel);color:var(--text);font-size:20px;font-weight:900}.action span{display:block;font-size:34px;margin-bottom:8px}
.hidden{display:none!important}.note{text-align:center;color:#6f7b72;font-size:12px;margin:18px 0}
.toast{position:fixed;left:50%;bottom:28px;transform:translateX(-50%);background:#f3f5f3;color:#111;padding:12px 16px;border-radius:12px;font-weight:800;display:none;z-index:20}.toast.show{display:block}
</style>
</head>
<body>
<main>
<header>
  <div class="brand"><div class="logo">ATS</div><div><h1>真人 CS 戰術系統</h1><div class="sub">Airsoft Tactical System</div></div></div>
  <button class="btn secondary" style="min-height:46px;font-size:18px" onclick="go('home')">首頁</button>
</header>

<section id="home" class="screen active">
  <div class="card hero"><div class="eyebrow">ATS WEB v0.2</div><h2>建立或加入<br>即時對戰房間</h2><p>免註冊，使用匿名身分加入。房間、玩家與陣亡狀態會透過 Firebase 同步。</p></div>
  <div class="stack">
    <button class="btn primary" onclick="go('create')">建立房間</button>
    <button class="btn secondary" onclick="go('join')">加入房間</button>
  </div>
  <p class="note" id="loginState">正在連線 Firebase…</p>
</section>

<section id="create" class="screen">
  <div class="card">
    <h2>建立房間</h2>
    <div class="field"><label>裁判名稱</label><input id="hostName" maxlength="20" placeholder="例如：裁判"></div>
    <div class="field"><label>場次名稱</label><input id="gameName" maxlength="30" value="今晚對戰"></div>
    <div class="field"><label>遊戲時間</label><select id="minutes"><option>15</option><option selected>30</option><option>45</option><option>60</option></select></div>
    <button class="btn primary" style="width:100%" onclick="createRoom()">產生房號</button>
  </div>
</section>

<section id="join" class="screen">
  <div class="card">
    <h2>加入房間</h2>
    <div class="field"><label>六位房號</label><input id="joinCode" inputmode="numeric" maxlength="6" placeholder="例如：726531"></div>
    <div class="field"><label>玩家名稱</label><input id="joinName" maxlength="20" placeholder="輸入名稱"></div>
    <div class="field"><label>隊伍</label><select id="joinTeam"><option>紅隊</option><option>藍隊</option></select></div>
    <button class="btn primary" style="width:100%" onclick="joinRoom()">加入</button>
  </div>
</section>

<section id="lobby" class="screen">
  <div class="card">
    <div class="status"><span class="badge" id="lobbyStatus">等待中</span><strong id="lobbyGame">今晚對戰</strong></div>
    <div class="roomcode" id="lobbyCode">000000</div>
    <p class="note">分享房號給其他玩家</p>
  </div>
  <div class="card">
    <div class="status"><strong>玩家名單</strong><span id="count">0 人</span></div>
    <div id="players" class="list" style="margin-top:12px"></div>
  </div>
  <div id="hostControls" class="stack hidden">
    <button class="btn primary" onclick="startGame()">開始遊戲</button>
    <button class="btn danger" onclick="endGame()">結束房間</button>
  </div>
</section>

<section id="game" class="screen">
  <div class="card">
    <div class="status"><span class="badge" id="aliveBadge">🟢 存活</span><strong id="gameTitle">今晚對戰</strong></div>
    <div class="timer" id="timer">30:00</div>
    <p class="note"><span id="gameTeam"></span>｜<span id="gamePlayer"></span></p>
  </div>
  <div id="aliveActions" class="actions">
    <button class="action" onclick="toast('PTT 語音將於後續版本加入')"><span>🎙️</span>PTT</button>
    <button class="action" onclick="markHit()" style="background:#3a1515"><span>💀</span>我已陣亡</button>
    <button class="action" onclick="toast('已呼叫裁判')"><span>🆘</span>呼叫裁判</button>
    <button class="action" onclick="toast('任務：殲滅敵隊')"><span>📋</span>任務</button>
  </div>
  <div id="deadCard" class="card hidden" style="text-align:center;padding:38px 18px"><div style="font-size:58px">💀</div><h2 style="font-size:36px">你已陣亡</h2><p class="note">等待裁判處置</p></div>
</section>
</main>
<div id="toast" class="toast"></div>

<script type="module">
import { initializeApp } from "https://www.gstatic.com/firebasejs/12.16.0/firebase-app.js";
import { getAuth, signInAnonymously, onAuthStateChanged } from "https://www.gstatic.com/firebasejs/12.16.0/firebase-auth.js";
import { getFirestore, doc, setDoc, getDoc, updateDoc, onSnapshot, collection, serverTimestamp, deleteDoc } from "https://www.gstatic.com/firebasejs/12.16.0/firebase-firestore.js";

const firebaseConfig={
 apiKey:"AIzaSyACA7Igl-kD2-Pw6aUAY9mk9LW0ECPIwY0",
 authDomain:"ats-c0912.firebaseapp.com",
 projectId:"ats-c0912",
 storageBucket:"ats-c0912.firebasestorage.app",
 messagingSenderId:"293926592919",
 appId:"1:293926592919:web:f8ef3f5996c716e799a4d2"
};
const app=initializeApp(firebaseConfig), auth=getAuth(app), db=getFirestore(app);

let uid="",roomCode="",isHost=false,me={name:"",team:"",alive:true},roomUnsub=null,playersUnsub=null,timerInt=null,roomData=null;

window.go=(id)=>{document.querySelectorAll('.screen').forEach(x=>x.classList.remove('active'));document.getElementById(id).classList.add('active');window.scrollTo(0,0)};
window.toast=(m)=>{const t=document.getElementById('toast');t.textContent=m;t.classList.add('show');setTimeout(()=>t.classList.remove('show'),1800)};
function code(){return String(Math.floor(100000+Math.random()*900000))}
function fmt(s){s=Math.max(0,s);return String(Math.floor(s/60)).padStart(2,'0')+":"+String(s%60).padStart(2,'0')}

signInAnonymously(auth).catch(e=>toast("登入失敗："+e.message));
onAuthStateChanged(auth,u=>{if(u){uid=u.uid;document.getElementById('loginState').textContent="Firebase 已連線"}});

window.createRoom=async()=>{
 if(!uid)return toast("請稍候連線");
 const name=document.getElementById('hostName').value.trim()||"裁判";
 const game=document.getElementById('gameName').value.trim()||"未命名場次";
 const mins=Number(document.getElementById('minutes').value);
 roomCode=code();isHost=true;me={name,team:"裁判",alive:true};
 await setDoc(doc(db,"rooms",roomCode),{gameName:game,minutes:mins,status:"waiting",hostUid:uid,createdAt:serverTimestamp(),startedAt:null});
 await setDoc(doc(db,"rooms",roomCode,"players",uid),{name,team:"裁判",alive:true,role:"host",joinedAt:serverTimestamp()});
 enterLobby();
};

window.joinRoom=async()=>{
 if(!uid)return toast("請稍候連線");
 const c=document.getElementById('joinCode').value.trim(),n=document.getElementById('joinName').value.trim(),team=document.getElementById('joinTeam').value;
 if(c.length!==6)return toast("請輸入六位房號");
 if(!n)return toast("請輸入玩家名稱");
 const snap=await getDoc(doc(db,"rooms",c));
 if(!snap.exists())return toast("找不到此房間");
 roomCode=c;isHost=false;me={name:n,team,alive:true};
 await setDoc(doc(db,"rooms",c,"players",uid),{name:n,team,alive:true,role:"player",joinedAt:serverTimestamp()});
 enterLobby();
};

function enterLobby(){
 document.getElementById('lobbyCode').textContent=roomCode;
 document.getElementById('hostControls').classList.toggle('hidden',!isHost);
 go('lobby');
 if(roomUnsub)roomUnsub(); if(playersUnsub)playersUnsub();
 roomUnsub=onSnapshot(doc(db,"rooms",roomCode),s=>{
  if(!s.exists()){toast("房間已結束");go('home');return}
  roomData=s.data();document.getElementById('lobbyGame').textContent=roomData.gameName;document.getElementById('lobbyStatus').textContent=roomData.status==="waiting"?"等待中":roomData.status==="running"?"進行中":"已結束";
  if(roomData.status==="running")enterGame();
 });
 playersUnsub=onSnapshot(collection(db,"rooms",roomCode,"players"),q=>{
  const box=document.getElementById('players');box.innerHTML="";document.getElementById('count').textContent=q.size+" 人";
  q.forEach(d=>{const p=d.data();const el=document.createElement('div');el.className="player";el.innerHTML=`<div><strong>${esc(p.name)}</strong><small>${p.team}｜${p.alive?"🟢 存活":"🔴 陣亡"}</small></div>`;box.appendChild(el);if(d.id===uid){me=p;syncAlive()}});
 });
}

window.startGame=async()=>{if(!isHost)return;await updateDoc(doc(db,"rooms",roomCode),{status:"running",startedAt:Date.now()})};
window.endGame=async()=>{if(!isHost)return;await deleteDoc(doc(db,"rooms",roomCode));go('home')};

function enterGame(){
 go('game');document.getElementById('gameTitle').textContent=roomData.gameName;document.getElementById('gamePlayer').textContent=me.name;document.getElementById('gameTeam').textContent=me.team;syncAlive();
 clearInterval(timerInt);timerInt=setInterval(()=>{const start=Number(roomData.startedAt||Date.now());const total=Number(roomData.minutes||30)*60;const left=total-Math.floor((Date.now()-start)/1000);document.getElementById('timer').textContent=fmt(left);if(left<=0)clearInterval(timerInt)},1000);
}
window.markHit=async()=>{if(!roomCode)return;await updateDoc(doc(db,"rooms",roomCode,"players",uid),{alive:false})};
function syncAlive(){const alive=me.alive!==false;document.getElementById('aliveBadge').textContent=alive?"🟢 存活":"🔴 已陣亡";document.getElementById('aliveActions').classList.toggle('hidden',!alive);document.getElementById('deadCard').classList.toggle('hidden',alive)}
function esc(s){return String(s).replace(/[&<>"']/g,c=>({"&":"&amp;","<":"&lt;",">":"&gt;",'"':"&quot;","'":"&#039;"}[c]))}
</script>
</body>
</html>
